# Copy to .env.local. With nothing set, Sunroll runs on the local backend (data stays in your browser).

# Backend: "local" (default) or "supabase"
VITE_DATA_BACKEND=local
# From your Supabase project: Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Where the app is served. "/" for a root domain, "/Sunroll/" for GitHub Pages.
VITE_BASE=/
# Public origin for share links, e.g. https://nweinberg97.github.io/Sunroll (optional)
VITE_PUBLIC_URL=
